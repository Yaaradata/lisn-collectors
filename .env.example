# OpenTelemetry → SigNoz Cloud (foundation). Leave OTEL_ENABLED unset/0 locally
# unless deliberately verifying; never ship test traffic to SigNoz by accident.
# OTEL_ENABLED=1
# OTEL_SERVICE_NAME=lisn-collector-api
# OTEL_EXPORTER_OTLP_ENDPOINT=ingest.us2.signoz.cloud:443
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://ingest.us2.signoz.cloud/v1/logs
# OTEL_LOGS_EXPORT_SCHEDULE_MS=2000
# SIGNOZ_INGESTION_KEY is mounted from Secret Manager in Cloud Run — never put
# the literal key in this file, the Dockerfile, or git.
#   Secret id: signoz-ingestion-key
#   Create (after rotating in SigNoz): SIGNOZ_INGESTION_KEY_FILE=/secure/path
# DEPLOYMENT_ENV=pilot
# SERVICE_VERSION=

# Structured logging (JSON to stdout + optional OTLP via OTEL). Default INFO.
# LOG_LEVEL=INFO
# Per-page DEBUG sample rate: emit when page_no % N == 0. Never samples WARNING+.
# LOG_DEBUG_SAMPLE_N=100

# Apply after deploy / local schema: sql/014_trace_context.sql
# (W3C traceparent on collector_job for API→worker span linking)

# Maintenance worker ONLY — observable gauges scrape global DB state.
# Three enrichment workers reporting the same gauge would triple-count and
# make every alert wrong. scripts/27_deploy_workers.sh sets this for
# COLLECTOR_SOURCE=maintenance.
# ENABLE_PERIODIC=1
