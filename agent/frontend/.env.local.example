# Browser API base — baked into the JS bundle at BUILD time (Next.js public env).
# Production Cloud Run build MUST set this to /api/agent (see cloudbuild.yaml).
# NEVER build with http://localhost — deployed UI would call your laptop.
# NEXT_PUBLIC_AGENT_API_URL=/api/agent

# Server-side proxy target (runtime on Cloud Run, not exposed to the browser):
# AGENT_BACKEND_URL=https://collector-agent-….run.app
#
# Local development (Option 2 — proxy only, not for production):
#   Terminal A: gcloud run services proxy collector-agent --region=asia-south1 --port=8090
#   Terminal B: AGENT_BACKEND_URL=http://127.0.0.1:8090 npm run dev
#
# Or run the backend locally: uvicorn on :8090 with the same AGENT_BACKEND_URL.
